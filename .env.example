DATABASE_URL=postgres://dashboard_readonly:senha@host:porta/baseapollo
ANTHROPIC_API_KEY=sk-ant-...

# Banco próprio do Painel Administrativo (usuários, permissões, sugestões,
# histórico) — separado do baseapollo, precisa de permissão de escrita.
ADMIN_DATABASE_URL=postgres://usuario:senha@host:porta/admin_omni
# Senha única para entrar em /admin.
ADMIN_PASSWORD=troque-esta-senha
# Opcional — se não definida, ADMIN_PASSWORD também assina o cookie de sessão.
ADMIN_SESSION_SECRET=troque-este-segredo
