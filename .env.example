DATABASE_URL=postgres://dashboard_readonly:senha@host:porta/baseapollo
DEEPSEEK_API_KEY=sk-...

# Banco próprio do Painel Administrativo (usuários, permissões, sugestões,
# histórico) — separado do baseapollo, precisa de permissão de escrita.
ADMIN_DATABASE_URL=postgres://usuario:senha@host:porta/admin_omni
# Senha única para entrar em /admin.
ADMIN_PASSWORD=troque-esta-senha
# Opcional — se não definida, ADMIN_PASSWORD também assina o cookie de sessão.
ADMIN_SESSION_SECRET=troque-este-segredo

# Custo estimado das campanhas no dashboard (coluna "Custo" = Apollo + DeepSeek + Hunter).
# Cotação usada pra converter USD -> BRL. Flutua, ajustar de vez em quando.
USD_BRL=5.13

# Apollo: plano mensal e créditos do ciclo (painel do Apollo mostra os dois).
APOLLO_PRECO_MENSAL_USD=236
APOLLO_CREDITOS_CICLO=10060
# Créditos gastos, em média, por empresa consultada — calibrado na ICP - PedBot
# (299 créditos / 43 empresas). Remedir quando o perfil das listas mudar muito.
APOLLO_CREDITOS_POR_EMPRESA=6.95

# DeepSeek (escolhe o decisor, 1 chamada por empresa consultada): recarga pré-paga,
# não assinatura. DEEPSEEK_CHAMADAS_TRIMESTRE é o volume real dos últimos 3 meses
# completos usado como cota de referência — não é um limite do plano.
DEEPSEEK_PRECO_TRIMESTRAL_USD=5
DEEPSEEK_CHAMADAS_TRIMESTRE=5140

# Hunter (busca e-mail quando Apollo e Gemini não acham): plano Starter.
HUNTER_PRECO_MENSAL_USD=49
HUNTER_CREDITOS_CICLO=2000
